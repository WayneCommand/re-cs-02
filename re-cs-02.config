# Minimal seed config for JDCloud RE-CS-02 (qualcommax/ipq60xx).
#
# Only non-default choices belong here. Everything else (DEFAULT_* packages,
# BUSYBOX_DEFAULT_*, KERNEL_*, toolchain, image format, ...) is derived and
# gets filled in by `make defconfig`.
#
# Usage (feeds must be installed FIRST, otherwise feed symbols are unknown
# and silently dropped):
#   cp re-cs-02.config .config && make defconfig

# --- target / device ---
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

# --- images ---
# The device can only be installed via TFTP + initramfs (+ sysupgrade),
# so the initramfs image is required, not optional.
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# --- storage / extroot (eMMC internal disk + USB) ---
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# --- USB network / serial (tethering, LTE dongles) ---
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial=y

# --- wireguard ---
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# --- luci + apps ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_https-dns-proxy=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# --- ssh / misc ---
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_htop=y
