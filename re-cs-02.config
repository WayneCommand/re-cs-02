# Minimal seed config for JDCloud RE-CS-02 (qualcommax/ipq60xx).
#
# Only non-default choices belong here. Everything else (DEFAULT_* packages,
# BUSYBOX_DEFAULT_*, KERNEL_*, toolchain, image format, ...) is derived and
# gets filled in by `make defconfig`.
#
# Usage (feeds must be installed FIRST, otherwise feed symbols are unknown
# and silently dropped):
#   cp re-cs-02.config .config && make defconfig

# --- target / device ---
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

# --- build options ---
# CCACHE is `bool "Use ccache" if DEVEL`, i.e. its prompt is invisible without
# DEVEL: kconfig then recomputes it to n and defconfig drops the ccache line.
# Cache dir is $(TOPDIR)/.ccache (rules.mk overrides CCACHE_DIR).
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# --- images ---
# The device can only be installed via TFTP + initramfs (+ sysupgrade),
# so the initramfs image is required, not optional.
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# --- NSS / PPE hardware offload ---
# Wi-Fi data path on the NSS cores. These symbols only exist in the
# openwrt-ppe-nss base tree (see README); on plain openwrt main `make
# defconfig` drops them without a word.
CONFIG_PACKAGE_kmod-nss-wifi-drv=y
CONFIG_ATH11K_NSS_WIFI=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# --- storage / extroot (eMMC internal disk + USB) ---
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# --- USB network / serial (tethering, LTE dongles) ---
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial=y

# --- wireguard ---
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# --- luci + apps ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
# NOTE: with the PPE/NSS offload, cake on an ifb never sees offloaded flows.
# `hw_ppe.qos` (the PPE shaper script) lives in the builder repo, not in the
# stock feeds. Either patch sqm-scripts for it, or use qca-ppe-qos, or accept
# that SQM only shapes what stays on the host.
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_https-dns-proxy=y
CONFIG_PACKAGE_luci-app-openclash=y
# Language switch instead of per-package luci-i18n-* symbols: every luci app
# installed then ships its own translation package, which is immune to the
# per-app symbol naming (luci-i18n-<app>-zh-cn) drifting between releases.
CONFIG_LUCI_LANG_zh_Hans=y

# --- ssh / misc ---
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_htop=y
